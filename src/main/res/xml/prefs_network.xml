<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android">

	<PreferenceCategory android:title="@string/prefs_category_network">
        <ListPreference
                android:title="@string/pref_read_source_title"
                android:key="@string/pref_read_source_key"
                android:summary="@string/pref_read_source_summary"
                android:entries="@array/read_source_entries"
                android:entryValues="@array/read_source_values"
                android:defaultValue="arctic"/>
        <Preference
                android:title="@string/pref_web_session_title"
                android:key="pref_web_session_configure"
                android:summary="@string/pref_web_session_summary"/>
		<EditTextPreference
				android:title="@string/pref_redlib_url_title"
				android:key="@string/pref_redlib_url_key"
				android:summary="@string/pref_redlib_url_summary"
				android:inputType="textUri"
				android:defaultValue=""/>
		<EditTextPreference
				android:title="@string/pref_redlib_api_key_title"
				android:key="@string/pref_redlib_api_key_key"
				android:inputType="textPassword"
				android:defaultValue=""/>

		<CheckBoxPreference
				android:title="@string/pref_network_tor_title"
				android:key="@string/pref_network_tor_key"
				android:summary="@string/pref_network_tor_summary"
				android:defaultValue="false"/>

		<EditTextPreference
				android:title="@string/pref_reddit_client_id_override_title"
				android:key="@string/pref_reddit_client_id_override_key"
				android:defaultValue=""/>

	</PreferenceCategory>

</PreferenceScreen>
